# ─────────────────────────────────────────────────────────────
# Cards Center — environment variables
# Kopieer naar .env (lokaal) of zet ze in het Railway-dashboard (productie).
# .env zelf staat in .gitignore — nooit committen.
# ─────────────────────────────────────────────────────────────

# Database ----------------------------------------------------
# LOKAAL: laat DATABASE_URL leeg of zet "file:dev.db" — dan gebruikt de app
#         het lokale SQLite-bestand en is geen token nodig.
# PRODUCTIE (Railway): de Turso libSQL-URL + bijbehorend auth-token.
#   DATABASE_URL="libsql://<jouw-db>-<org>.turso.io"
#   TURSO_AUTH_TOKEN="<turso-token>"
DATABASE_URL="file:dev.db"
TURSO_AUTH_TOKEN=""

# Auth (Auth.js v5) -------------------------------------------
# AUTH_SECRET: genereer met `npx auth secret` of `openssl rand -base64 32`.
# AUTH_TRUST_HOST: op Railway op true zetten (achter reverse proxy).
# NEXTAUTH_URL: de publieke URL van de site, zonder trailing slash.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://<jouw-domein>"

# Publieke site-URL ------------------------------------------
# Zet IDENTIEK aan NEXTAUTH_URL. Wordt gebruikt voor links in e-mails, de
# sitemap, de ICS-agenda-export en de shop-URL-preview (src/lib/site-url.ts).
# Ontbreken beide, dan valt de app terug op localhost en logt dat in productie.
# NEXT_PUBLIC_* is build-time → na wijziging een rebuild/redeploy nodig.
NEXT_PUBLIC_SITE_URL="https://<jouw-domein>"

# Cron-beveiliging --------------------------------------------
# VERPLICHT in productie. Alle crons draaien in-process (src/instrumentation.ts),
# maar de /api/cron/*-routes blijven bestaan als safety-net + "Run nu". Zonder
# CRON_SECRET weigeren die routes in productie alle externe calls (alleen een
# admin-sessie werkt nog); lokaal mag hij leeg. Genereer: `openssl rand -hex 32`.
CRON_SECRET=""

# Bestandsopslag — Cloudflare R2 ------------------------------
# PRODUCTIE (Railway): geüploade foto's gaan naar R2 i.p.v. de containerschijf
#   (die bij elke redeploy gewist wordt). Alle vier vereist om R2 te activeren.
# LOKAAL: laat leeg → upload/serve vallen terug op public/uploads/ op schijf.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Beta-gate (pre-launch) --------------------------------------
# Schermt de hele site af achter één gedeeld wachtwoord zolang BETA_GATE=true.
# Zet beide op de Railway-service tijdens de testfase; bij launch BETA_GATE=false
# (of verwijderen). Crawlers worden tijdens de gate geweerd via robots.ts.
BETA_GATE="false"
BETA_ACCESS_PASSWORD=""

# E-mail (Fase 42) --------------------------------------------
# EMAIL_PROVIDER: "console" (of leeg) = mock, mails worden alleen gelogd.
#                 "resend" = écht versturen via Resend.
# RESEND_API_KEY: API-key uit het Resend-dashboard (vereist bij provider=resend).
# EMAIL_FROM: afzender, bv. "Cards Center <noreply@cards-center.eu>".
#             Het domein (cards-center.eu) moet in Resend geverifieerd zijn (DNS).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Cards Center <noreply@cards-center.eu>"
# EMAIL_REPLY_TO (Fase 16, optioneel): waar replies binnenkomen. Leeg laten =
# pure noreply (aanbevolen — contact loopt via de site, niet via mail-replies).
EMAIL_REPLY_TO=""

# Optioneel ---------------------------------------------------
# Image-moderatie via Claude (leeg = uploads gaan ongechecked door — fail-open).
ANTHROPIC_API_KEY=""
# PokeWallet prijs-sync — VERPLICHT in productie. Leeg = sync-cron faalt
# met "POKEWALLET_API_KEY not configured" voor elke set. Lokaal: leeg = sync
# slaat over en je werkt met de prijzen die je al hebt.
POKEWALLET_API_KEY=""

# Feature-flags (Community Hub, Fase 1) ----------------------
# De oude handelsfuncties zijn verborgen achter server-side flags. Weglaten of
# leeg = UIT. Alleen "true" (of 1/on) zet een functie aan voor iedereen; admins
# zien de functies altijd. De drie handel-flags vereisen FEATURE_WALLET.
# FEATURE_COMMUNITY_EVENTS = door leden ingediende beurzen (Europa-kalender);
# uit = alleen winkel-events van Cards Center.
FEATURE_WALLET="false"
FEATURE_AUCTIONS="false"
FEATURE_CLAIMSALES="false"
FEATURE_MARKETPLACE="false"
FEATURE_COMMUNITY_EVENTS="false"
# FEATURE_XP = rang/XP/levels/prestaties (geparkeerd tot de league; ook voor admins uit)
FEATURE_XP="false"
# FEATURE_CARD_DATABASE = openbare kaartendatabase + pokédex + kaarten zoeken. Gaat vanzelf
# aan zodra een handel-flag aan staat; uit = prijzen alleen in de verkoopcalculator.
FEATURE_CARD_DATABASE="false"

# Mollie (tickets + eten, Community Hub Fase 3/4). Leeg = simulatiemodus: geen
# externe calls, betalingen bevestig je lokaal op /betalen/simuleer/<id>.
# test_... = Mollie test-modus (echte checkout, geen echt geld), live_... = productie.
# De webhook (/api/mollie/webhook) vereist een publieke NEXT_PUBLIC_SITE_URL.
MOLLIE_API_KEY=""

# IBAN-versleuteling (Community Hub, Fase 6): 32 bytes, base64 of 64 hex-tekens.
# Genereer met `openssl rand -base64 32`. Verplicht in productie; lokaal valt de
# app terug op een sleutel afgeleid van AUTH_SECRET. Verlies je de sleutel, dan
# zijn opgeslagen IBANs niet meer leesbaar. Bestaande rijen: scripts/encrypt-ibans.ts.
IBAN_ENCRYPTION_KEY=""

